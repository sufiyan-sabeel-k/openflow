# Example only — never commit real secrets.
# Copy to .env (git-ignored) if your backend/app needs it.

# Supabase (publishable values only; NEVER put service_role here)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Backend API base (separately hosted; Pages cannot run it)
BACKEND_BASE_URL=https://your-api-host.example.com

# Google OAuth client ID only (public identifier; secret stays server-side)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Sarvam AI key — SERVER SIDE ONLY. Never use in browser code or Pages repo.
# SARVAM_API_KEY is intentionally commented out here.
# SARVAM_API_KEY=SET_ON_SERVER_ONLY
